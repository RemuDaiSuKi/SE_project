@startuml class
title 課堂搶答系統 類別圖（學習單、Google 存取、搶答活動、結果契約）
skinparam defaultFontName "Microsoft JhengHei"
hide empty members

package "格子資料（與資料來源無關）" {
  class SpreadsheetGrid {
    spreadsheet_id: str
    title: str
    sheets: tuple[SheetGrid]
    sheet(sheet_id): SheetGrid?
  }
  class SheetGrid {
    sheet_id: int
    title: str
    {field} values: dict[(row, col), value]
    {field} merges: tuple[(r0, c0, r1, c1)]
    max_row: int
    without(positions): SheetGrid
  }
  SpreadsheetGrid "1" *-- "many" SheetGrid
}

package "學習單" {
  class Labels {
    no: str
    question: str
    answer: str
  }
  class Question {
    no: int
    sheet_id: int
    sheet_name: str
    cell_ref: str
    row: int
    source_no: str?
    sub_label: str?
    group_no: int?
    identity(): tuple
  }
  class QuestionGroup {
    group_no: int
    source_no: str?
    sheet_id: int
    sheet_name: str
    range_ref: str
    question_nos: tuple[int]
    identity(): tuple
  }
  class ParsedWorksheet {
    labels: Labels
    questions: tuple[Question]
    groups: tuple[QuestionGroup]
  }
  class StoredWorksheet {
    id: int
    spreadsheet_id: str
    spreadsheet_url: str
    title: str
    confirmed_at: str
    parsed: ParsedWorksheet
  }
  class Preview {
    preview_id: str
    spreadsheet_id: str
    spreadsheet_url: str
    title: str
    parsed: ParsedWorksheet
  }
  class PreviewStore {
    add(...): Preview
    confirm(id, save): StoredWorksheet?
    cancel(id): bool
  }
  note right of PreviewStore
    存在 SQLite（worksheet_previews），沒有期限；
    狀態只能 pending → confirmed / cancelled 一次
  end note
  class WorksheetStore {
    save(preview): StoredWorksheet
    get(id): StoredWorksheet?
    list(): list[StoredWorksheet]
  }
  ParsedWorksheet *-- Labels
  ParsedWorksheet *-- "many" Question
  ParsedWorksheet *-- "many" QuestionGroup
  StoredWorksheet *-- ParsedWorksheet
  Preview *-- ParsedWorksheet
  PreviewStore o-- "many" Preview
  WorksheetStore ..> StoredWorksheet
}

package "Google 存取" {
  interface SheetsGateway {
    fetch(spreadsheet_id): SpreadsheetGrid
    write_cells(spreadsheet_id, writes): None
  }
  class GoogleSheetsGateway {
    timeout_seconds: float
    {field} session_factory: (Credentials) -> Session
  }
  class GoogleAuth {
    client_secrets_file: Path
    token_file: Path
    credentials(): Credentials
    account(): str?
    status(): AuthStatus
  }
  class AuthStatus {
    configured: bool
    authorized: bool
    account: str?
  }
  class CellWrite {
    sheet_title: str
    cell_ref: str
    text: str
  }
  class SheetsError {
    kind: not_authorized | auth_expired | not_found | forbidden | unavailable
    account: str?
    message: str
  }
  SheetsGateway <|.. GoogleSheetsGateway
  GoogleSheetsGateway --> GoogleAuth
  GoogleAuth ..> AuthStatus
  SheetsGateway ..> SpreadsheetGrid
  SheetsGateway ..> CellWrite
  SheetsGateway ..> SheetsError
}

package "活動結果契約" {
  class ActivityResult {
    activity_id: int
    worksheet_id: int
    ended_at: datetime
  }
  class ResultGroup {
    group_id: int
    name: str
  }
  class ResultUnit {
    unit_id: str
    question_nos: tuple[int]
  }
  class ResultRecord {
    rank: int
    group_id: int
    answers: dict[int, str]
    invalidated: bool
  }
  interface FinalResultSource {
    lookup(activity_id): FinalResultLookup
  }
  ActivityResult *-- "many" ResultGroup
  ActivityResult *-- "many" ResultUnit
  ResultUnit *-- "many" ResultRecord
  FinalResultSource ..> ActivityResult
}

package "搶答活動" {
  class ActivityRegistry {
    latest: ActivityEngine?
    current: ActivityEngine?
    startup(): int
    create(worksheet_id, teams, fairness, N, K): ActivityEngine
    get(activity_id): ActivityEngine
    phase_of(activity_id): str
    find_team_by_code(code): (ActivityEngine, TeamState)?
  }
  class ActivityEngine {
    info: ActivityInfo
    units: list[BuzzUnit]
    teams: dict[int, TeamState]
    submissions: list[Submission]
    cooldowns: dict[int, Cooldown]
    start() / end()
    submit(team, version, unit_key, answers)
    invalidate(unit_key)
    regenerate_code(team)
    view_for_teacher() / view_for_team(team) / results_view()
    to_result(): ActivityResult
  }
  note right of ActivityEngine
    成功者一律以 winner_of 推導；
    所有變更在 asyncio.Lock 內依序執行
  end note
  class ActivityInfo {
    id: int
    worksheet_id: int
    phase: preparing | running | ended | interrupted
    fairness_enabled: bool
    cooldown_seconds: int
    cooldown_lead: int
  }
  class TeamState {
    id: int
    name: str
    code_hash: str
    code_version: int
    code: str?（只在記憶體）
  }
  class Submission {
    id: int
    unit_key: str
    team_id: int
    answers: dict[int, str]
    rank: int
    invalidated: bool
  }
  class Cooldown {
    until: float
    trigger_id: int
  }
  class BuzzUnit {
    key: str（單題 Qn、題組 Gn）
    question_nos: tuple[int]
    display: str
  }
  class Event {
    audience: teacher | team | all | revoke
    payload: dict
    team_id: int?
  }
  class JoinLimiter {
    check_allowed(window)
    record_failure(window)
    record_success(window)
  }
  class SqliteActivityRepository {
    create_activity(...)
    persist_results(...)
    update_invalidation(...)
    mark_unfinished_interrupted()
  }
  class SqliteResultSource {
    lookup(activity_id): FinalResultLookup
  }
  class Hub {
    connections: list[Connection]
    dispatch(engine, events)
  }
  ActivityRegistry o-- "many" ActivityEngine
  ActivityRegistry --> SqliteActivityRepository
  ActivityEngine *-- ActivityInfo
  ActivityEngine *-- "many" TeamState
  ActivityEngine *-- "many" Submission
  ActivityEngine *-- "many" Cooldown
  ActivityEngine *-- "many" BuzzUnit
  ActivityEngine ..> Event
  ActivityEngine --> SqliteActivityRepository
  Hub --> ActivityRegistry
  Hub ..> Event
  SqliteResultSource --> SqliteActivityRepository
}

SqliteResultSource ..|> FinalResultSource
ActivityEngine ..> ActivityResult : to_result
BuzzUnit ..> ParsedWorksheet : build_units

class WritebackReport {
  written: tuple[int]
  empty: tuple[int]
  skipped_filled: tuple[int]
}

ActivityResult ..> StoredWorksheet : worksheet_id
WritebackReport ..> ActivityResult : write_back 依結果與\n重新讀取的試算表產生
@enduml

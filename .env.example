# 複製為 .env 後填入實際值；.env 不可加入版本控制。

# 老師登入密碼（必填，未設定時伺服器拒絕啟動）
BUZZER_TEACHER_PASSWORD=change-me

# 監聽位址與 port（預設只監聽本機 127.0.0.1）
BUZZER_HOST=127.0.0.1
BUZZER_PORT=8000

# 資料目錄（SQLite 資料庫與 Google 授權檔）
BUZZER_DATA_DIR=./data

# 匯入題數上限
BUZZER_MAX_QUESTIONS=500

# Google OAuth 用戶端設定檔（從 Google Cloud 下載的「桌面應用程式」JSON）與授權檔
# 未設定時分別預設為 <資料目錄>/google-client-secret.json 與 <資料目錄>/google-token.json
# 缺少用戶端設定檔或尚未執行 google-login 時，伺服器拒絕啟動
# BUZZER_GOOGLE_CLIENT_SECRETS=./data/google-client-secret.json
# BUZZER_GOOGLE_TOKEN_FILE=./data/google-token.json
BUZZER_GOOGLE_TIMEOUT_SECONDS=10

# 表頭標籤
BUZZER_LABEL_NO=題號
BUZZER_LABEL_QUESTION=題目
BUZZER_LABEL_ANSWER=作答

# 老師登入：所有視窗共用的連續失敗次數與鎖定秒數
BUZZER_LOGIN_MAX_FAILURES=5
BUZZER_LOGIN_LOCK_SECONDS=300

# 同一視窗連續失敗鎖定（保留給組別代碼輸入）
BUZZER_LOCKOUT_MAX_FAILURES=5
BUZZER_LOCKOUT_SECONDS=60

# 老師 Token 有效時數
BUZZER_TOKEN_TTL_HOURS=8
